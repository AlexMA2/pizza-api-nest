# ─────────────────────────────────────────────────────────────────────────────
# DOCKERFILE FOR AWS LAMBDA CONTAINER DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build the source code ───────────────────────────────────────────
FROM node:22-alpine AS builder

RUN npm install -g pnpm@9
WORKDIR /usr/src/app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# ── Stage 2: Install production dependencies (Hoisted for Lambda Compatibility) ──
FROM node:22-alpine AS dependencies

RUN npm install -g pnpm@9
WORKDIR /usr/src/app

COPY package.json pnpm-lock.yaml ./

# Crucial: Use --shamefully-hoist=true to flat-pack all dependency modules 
# straight into the root node_modules directory. 
# Without hoisting, pnpm's default symlink-based node_modules structure
# causes ModuleNotFound errors in Lambda container runtimes.
RUN pnpm install --prod --frozen-lockfile --shamefully-hoist=true

# ── Stage 3: AWS Lambda Node.js Runtime Image ────────────────────────────────
FROM public.ecr.aws/lambda/nodejs:22 AS runner

# AWS Lambda custom working directory variable
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy build files and the flat-packed node_modules into the Lambda task root
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=dependencies /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/package.json ./package.json

# Expose production flags
ENV NODE_ENV=production

# AWS Lambda Container Handler pointing to our handler function
CMD ["dist/lambda.handler"]
